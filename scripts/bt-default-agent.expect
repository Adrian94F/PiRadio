#!/usr/bin/expect -f
# Registers a headless BlueZ pairing agent so phones (including iOS) can pair.
# Uses DisplayYesNo capability and auto-confirms all pairing requests.
# Keeps bluetoothctl open until the daemon exits — systemd will restart if needed.
log_user 0
set timeout 90
set prompt_re {\[[^\]]+\][#>] ?}
spawn bluetoothctl
expect {
    -re $prompt_re {}
    "Waiting to connect to bluetoothd" { exp_continue }
    timeout { puts stderr "pi-bluetooth-agent: timeout waiting for bluetoothctl prompt"; exit 1 }
}
send "power on\r"
expect {
    -re $prompt_re {}
    timeout { puts stderr "pi-bluetooth-agent: timeout after power on"; exit 1 }
}
send "discoverable-timeout 0\r"
expect {
    -re $prompt_re {}
    timeout {}
}
send "discoverable on\r"
expect {
    -re $prompt_re {}
    timeout {}
}
send "pairable on\r"
expect {
    -re $prompt_re {}
    timeout {}
}
send "agent DisplayYesNo\r"
expect {
    -re {Agent registered} {}
    -re $prompt_re {}
    timeout {}
}
send "default-agent\r"
expect {
    -re {successful} {}
    -re {Agent registered} {}
    -re $prompt_re {}
    timeout {}
}
log_user 1
puts stderr "pi-bluetooth-agent: DisplayYesNo agent active — auto-confirming all requests."
set timeout -1
expect {
    -re {Confirm passkey (\d+).*\(yes/no\)} {
        puts stderr "pi-bluetooth-agent: auto-confirming passkey $expect_out(1,string)"
        send "yes\r"
        exp_continue
    }
    -re {Request confirmation.*\(yes/no\)} {
        puts stderr "pi-bluetooth-agent: auto-confirming pairing"
        send "yes\r"
        exp_continue
    }
    -re {\[CHG\] Device ([0-9A-F:]{17}) Paired: yes} {
        set addr $expect_out(1,string)
        puts stderr "pi-bluetooth-agent: auto-trusting $addr"
        send "trust $addr\r"
        puts stderr "pi-bluetooth-agent: turning off discoverable"
        send "discoverable off\r"
        exp_continue
    }
    -re {Authorize service.*\(yes/no\)} {
        puts stderr "pi-bluetooth-agent: auto-authorizing service"
        send "yes\r"
        exp_continue
    }
    -re {Request authorization.*\(yes/no\)} {
        puts stderr "pi-bluetooth-agent: auto-authorizing"
        send "yes\r"
        exp_continue
    }
    eof {
        puts stderr "pi-bluetooth-agent: bluetoothctl exited."
    }
}
