[Unit]
Description=BlueZ headless pairing agent (NoInputNoOutput) for phones
Documentation=file:///opt/pi-audio-controller/scripts/bt-default-agent.expect
After=bluetooth.service bluealsa.service
Requires=bluetooth.service
Wants=bluealsa.service

[Service]
Type=simple
ExecStart=/usr/bin/expect -f /opt/pi-audio-controller/scripts/bt-default-agent.expect
Restart=on-failure
RestartSec=4
Environment=LANG=C

[Install]
WantedBy=multi-user.target
