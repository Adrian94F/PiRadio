[Unit]
Description=PiRadio HA Integration — MQTT bridge for Home Assistant
After=network-online.target mosquitto.service dbus.service pi-audio-controller.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
Environment=LOG_LEVEL=INFO
WorkingDirectory=/opt/pi-audio-controller
ExecStart=/opt/pi-audio-controller/venv-piradio-ha/bin/python3 -m ha_integration
Restart=on-failure
RestartSec=5

# Needs system D-Bus access for shairport-sync signals.
User=root

[Install]
WantedBy=multi-user.target
